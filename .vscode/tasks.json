{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Current Java File",
            "type": "shell",
            "command": "bash",
            "args": ["${workspaceFolder}/run.sh", "${file}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
